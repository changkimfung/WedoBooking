# QQ 邮箱示例（需在 QQ 邮箱 → 设置 → 账户 开启 SMTP 并生成授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-id@qq.com
SMTP_PASS=your-qq-authorization-code
SMTP_FROM=Wedo bookingsystem <your-id@qq.com>

# 通知收件人（可与前端 common.js 中 APPOINTMENT_NOTIFY_EMAIL 保持一致）
APPOINTMENT_NOTIFY_EMAIL=zhengjianfengb@sailvan.com
# 所有预约通知邮件额外抄送（与还柜通知一致）
APPOINTMENT_DEMO_CC_EMAIL=liuyongmeib@sailvan.com

# 对外访问根地址（可选）
# - 本地开发：可不填，默认 http://localhost:3847
# - 测试环境：填测试地址，例如 PUBLIC_BASE_URL=http://106.53.68.5:3847
# PUBLIC_BASE_URL=http://106.53.68.5:3847

# 企业微信智能表格 Webhook（SKU 创建后写入新品查验表，勿提交真实 key 到 Git）
# WECOM_SMARTSHEET_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=你的Key
# PDA 产品拍照提交后写入（字段：上传时间/运德编号/侵权审核状态/关联入库单/拍照仓库/操作人/图片链接）
# WECOM_SMARTSHEET_WEBHOOK_PHOTO=https://qyapi.weixin.qq.com/cgi-bin/wedoc/smartsheet/webhook?key=你的Key
# 关联入库单列 fieldId（企微 Webhook 示例 JSON 中 title=关联入库单 的 key）
# WECOM_PHOTO_INBOUND_ORDER_FIELD=fp0MC5
# 固定操作人（优先级高于随机生成）；不设则每次提交随机生成如 PDA-张明
# WECOM_PHOTO_OPERATOR_ACCOUNT=产品经理
# 设为 false 且未传 operator 时不写操作人列
# WECOM_PHOTO_OPERATOR_RANDOM=true
# 或合并写入 WECOM_PHOTO_FIELD_KEY_MAP：
# WECOM_PHOTO_FIELD_KEY_MAP={"uploadTime":"f3Qttt","yundeNo":"fMYD7u","auditStatus":"fJkfBD","inboundOrder":"fp0MC5","warehouse":"fYN4pL","operatorAccount":"fIS8bc","imageUrl":"fhS9ko"}
# 图片链接列 type=url，格式 [{ "link":"https://...", "text":"显示文案" }]
# 同 SKU 多图展开为多行：首行写全字段，后续行仅写图片链接
# 提醒时间列 type=text 时保持 false（默认）；若为「日期」列改为 true
# WECOM_REMIND_TIME_AS_DATE=false
# 若 fieldId 与默认不同，用 Webhook 示例 JSON 覆盖（新品查验表）：
# WECOM_FIELD_KEY_MAP={"yundeNo":"f04Gwj","customerCode":"ftk5Tx","inboundOrder":"fIEBDU","productName":"fA36o6","description":"fMAfWQ","nameCn":"fn8TJd","nameEn":"foZmis","remindTime":"faLj4m","auditStatus":"fTTDv2"}
# 旧列 productCode(ftQMc5) 已从企微表移除，勿再配置；代码会自动忽略该 fieldId
# SKU 同步时未传入库单则随机生成 RD+9位数字；设为 false 则不写该列
# WECOM_SKU_INBOUND_ORDER_RANDOM=true
