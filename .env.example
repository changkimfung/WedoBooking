# QQ 邮箱示例（需在 QQ 邮箱 → 设置 → 账户 开启 SMTP 并生成授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-id@qq.com
SMTP_PASS=your-qq-authorization-code
SMTP_FROM=运德预约通知 <your-id@qq.com>

# 通知收件人（可与前端 common.js 中 APPOINTMENT_NOTIFY_EMAIL 保持一致）
APPOINTMENT_NOTIFY_EMAIL=zhengjianfengb@sailvan.com
